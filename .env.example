# Railway Environment Variables
# Copy this to your Railway environment variables section

# Database Configuration (from Railway MySQL plugin)
DB_HOST=YOUR_RAILWAY_DB_HOST
DB_USER=YOUR_RAILWAY_DB_USER
DB_PASSWORD=YOUR_RAILWAY_DB_PASSWORD
DB_NAME=YOUR_RAILWAY_DB_NAME
DB_PORT=3306

# Railway Environment (automatically set by Railway)
RAILWAY_ENVIRONMENT=true

# Optional: Custom settings
APP_NAME="AME Zion University Portal"
APP_URL=YOUR_RAILWAY_APP_URL